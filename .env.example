# Copy to .env and fill in. Never commit .env or put it in the ZIP.
# Any OpenAI-compatible chat-completions endpoint works. We use the HKUST GenAI API service:
API_KEY=
BASE_URL=https://hkust.azure-api.net/hkust-genai/v1
MODEL=deepseek/deepseek-v4-flash-0731
# mock = replay examples/cache (no key needed); live = call the API and cache answers
LLM_PROVIDER=mock
